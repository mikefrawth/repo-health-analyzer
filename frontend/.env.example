# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Public — this one is sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public by design: it can only read Reports, because the
# reports table has a SELECT policy and no INSERT policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER-ONLY — it bypasses RLS entirely and is the
# only thing that can write a Report. Never expose it to the browser, and never
# rename it to NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Where the FastAPI backend is listening. No trailing slash needed.
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Shared secret. Must match INTERNAL_API_SECRET in backend/.env — the backend
# rejects any request that doesn't present it.
INTERNAL_API_SECRET=

# Stripe secret key. SERVER-ONLY — creates Checkout sessions and verifies
# webhooks. Never rename to NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=

# Signing secret for this app's Stripe webhook endpoint
# (/api/stripe/webhook). Stripe CLI's `stripe listen` prints one for local
# dev; the live dashboard issues a separate one per configured endpoint.
STRIPE_WEBHOOK_SECRET=

# The Stripe Price id for the app's single subscription plan (ticket #23
# is single-tier only for v1).
STRIPE_PRICE_ID=

# How many credits a successful billing period grants. Optional — defaults
# to 20 if unset. A business/finance decision (see the ticket's "Out of
# Scope"), not an engineering one.
STRIPE_MONTHLY_CREDITS=
