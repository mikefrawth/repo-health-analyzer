# Anthropic API key, used for the AI Summary.
# Without it the backend still returns Metrics and a Health Score (a Partial Report).
ANTHROPIC_API_KEY=

# Shared secret. Must match INTERNAL_API_SECRET in the frontend's .env.local —
# the backend rejects any request that doesn't present it.
INTERNAL_API_SECRET=

# Optional. Raises GitHub API rate limits for the repository size pre-check.
GITHUB_TOKEN=

# Optional overrides for the Analysis Scope caps and clone depth.
# MAX_REPO_SIZE_KB=200000
# MAX_FILES=500
# MAX_PYTHON_FILES=100
# MAX_JS_FILES=100
# CLONE_DEPTH=50

# Directory holding the pinned ESLint install for the JS/TS Complexity Signal.
# Set by the Dockerfile; locally, run `npm install` in ./js-analyzer and point here.
# JS_ANALYZER_DIR=/opt/js-analyzer
