    { "url": "github.com/owner/repo", "owner": "owner", "repo": "repo" },
    { "url": "https://www.github.com/owner/repo", "owner": "owner", "repo": "repo" },
    { "url": "https://github.com/owner/repo.git", "owner": "owner", "repo": "repo" },
    { "url": "https://github.com/owner/repo/", "owner": "owner", "repo": "repo" },
    { "url": "  https://github.com/owner/repo  ", "owner": "owner", "repo": "repo" },
    { "url": "https://github.com/my-org/my.repo", "owner": "my-org", "repo": "my.repo" },
    { "url": "https://github.com/my-org/my_repo.js", "owner": "my-org", "repo": "my_repo.js" },
    {
      "url": "https://github.com/mikefrawth/repo-health-analyzer",
